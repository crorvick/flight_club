# Copy to .env for local development: cp .env.example .env
DATABASE_URL=postgres://flightclub:flightclub@localhost:5432/flightclub
# Any 32+ character string locally; generate real ones with
# `openssl rand -base64 32`.
BETTER_AUTH_SECRET=local-development-secret-not-for-real-use
BETTER_AUTH_URL=http://localhost:3000
# Squawk photo storage: any S3-compatible bucket.  These match the
# storage service in docker-compose.yml; create the bucket with
# `pnpm storage:init`.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=flight-club-photos
S3_ACCESS_KEY_ID=flightclub
S3_SECRET_ACCESS_KEY=flightclub-secret
S3_FORCE_PATH_STYLE=true
# Signing in with Google and Apple: each is offered only when both its
# values are set (docs/deploy.md, "Signing in with Google and Apple").
# Apple can't redirect to localhost, so it's tried on staging instead.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
